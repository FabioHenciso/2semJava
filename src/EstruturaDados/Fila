    // EXERCICIO 1 
    public static <T> Queue<T> intercalarFilas(Queue<T> fila1, Queue<T> fila2) {

        Queue<T> resultado = new ArrayDeque<>();

        Queue<T> copia1 = new ArrayDeque<>(fila1);
        Queue<T> copia2 = new ArrayDeque<>(fila2);

        while (!copia1.isEmpty() || !copia2.isEmpty()) {

            if (!copia1.isEmpty()) {
                resultado.add(copia1.poll());
            }

            if (!copia2.isEmpty()) {
                resultado.add(copia2.poll());
            }
        }

        return resultado;
    }


    // EXERCICIO 2 
    public static String inverterPalavras(String texto) {

        Stack<Character> pilha = new Stack<>();
        String resultado = "";

        for (int i = 0; i < texto.length(); i++) {

            char letra = texto.charAt(i);

            if (!Character.isWhitespace(letra)) {

                pilha.push(letra);

            } else {

                while (!pilha.isEmpty()) {
                    resultado += pilha.pop();
                }

                resultado += letra;
            }
        }

        // Desempilha a ultima palavra
        while (!pilha.isEmpty()) {
            resultado += pilha.pop();
        }

        return resultado;
    }


    // TRABALHO - PARTE 1 - VERIFICAR PARENTESES, COLCHETES E CHAVES

    public static boolean verificarExpressao(String expressao) {

        Stack<Character> pilha = new Stack<>();

        for (int i = 0; i < expressao.length(); i++) {

            char caractere = expressao.charAt(i);

            // Verifica os simbolos de abertura
            if (caractere == '(' ||
                caractere == '[' ||
                caractere == '{') {

                pilha.push(caractere);

            }

            // Verifica os simbolos de fechamento
            else if (caractere == ')' ||
                     caractere == ']' ||
                     caractere == '}') {

                // Se nao existe abertura correspondente
                if (pilha.isEmpty()) {
                    return false;
                }

                char topo = pilha.pop();

                // Verifica se os simbolos correspondem
                if (caractere == ')' && topo != '(') {
                    return false;
                }

                if (caractere == ']' && topo != '[') {
                    return false;
                }

                if (caractere == '}' && topo != '{') {
                    return false;
                }
            }
        }

        
        return pilha.isEmpty();
    }


  
